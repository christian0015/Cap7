# .env.example
MONGODB_URI=
AUTH_SECRET=                # 32+ octets aléatoires
ADMIN_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://

# --- Fournisseur d'IA par tâche (aucun préréglage) : une valeur commentée, une ligne active (défaut : gemini) ---
# Si l'appel du fournisseur choisi échoue (erreur, délai dépassé, 429) : une seule bascule sur Gemini.
# Si Gemini est déjà le fournisseur choisi : un seul réessai (avec GEMINI_MODEL_FAST s'il est renseigné). Jamais de boucle.
# GRADER_PROVIDER=anthropic          # anthropic | gemini
GRADER_PROVIDER=gemini
# ITEMS_PROVIDER=anthropic           # anthropic | gemini
ITEMS_PROVIDER=gemini
# TRANSCRIBE_PROVIDER=openai         # openai | gemini
TRANSCRIBE_PROVIDER=gemini
# TTS_PROVIDER=openai                # openai | gemini
TTS_PROVIDER=gemini

# --- Clés par fournisseur (renseignez celles des fournisseurs choisis ; GEMINI_API_KEY sert aussi au repli) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Modèles par fournisseur (noms vérifiés dans les documentations officielles le 18/10/2026) ---
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe   # gpt-4o-transcribe reste accepté
OPENAI_MODEL_TTS=gpt-4o-mini-tts
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite  # aussi utilisé pour l'unique réessai si Gemini est le fournisseur choisi
GEMINI_MODEL_TRANSCRIBE=gemini-3.8-flash
GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts

# --- Palier Gemini, déclaré à la main ---
# free : coût compté à 0 ; Google peut réutiliser les contenus envoyés (palier gratuit de l'API). paid : prix réels ci-dessous.
GEMINI_TIER=free
# GEMINI_TIER=paid

# --- Fiabilité ---
AI_CALL_TIMEOUT_MS=          # délai maximum par appel sortant ; vide = 40 à 45 s selon la tâche

# --- Plafonds quotidiens (stockés dans usage_daily) ; 0 = désactivé pour les plafonds d'appels ---
MAX_DAILY_LLM_USD=15
MAX_DAILY_CALLS=2000
MAX_DAILY_CALLS_GEMINI=0     # mettre le quota quotidien de votre palier Gemini ; 0 = désactivé

# --- Prix (dollars par million de tokens) : grille tarifaire officielle de chaque fournisseur ---
PRICE_GRADER_IN_PER_MTOK=    # Anthropic, modèle SMART
PRICE_GRADER_OUT_PER_MTOK=
PRICE_FAST_IN_PER_MTOK=      # Anthropic, modèle FAST
PRICE_FAST_OUT_PER_MTOK=
PRICE_GEMINI_SMART_IN_PER_MTOK=      # utilisés seulement si GEMINI_TIER=paid
PRICE_GEMINI_SMART_OUT_PER_MTOK=     # (la sortie inclut la réflexion)
PRICE_GEMINI_FAST_IN_PER_MTOK=
PRICE_GEMINI_FAST_OUT_PER_MTOK=
PRICE_GEMINI_TRANSCRIBE_IN_PER_MTOK= # l'audio compte 32 tokens par seconde
PRICE_GEMINI_TRANSCRIBE_OUT_PER_MTOK=
PRICE_GEMINI_TTS_IN_PER_MTOK=
PRICE_GEMINI_TTS_OUT_PER_MTOK=
PRICE_OPENAI_TRANSCRIBE_PER_MIN=     # défaut 0,006 si vide
PRICE_OPENAI_TTS_PER_1K_CHARS=       # défaut 0,0167 si vide

LS_WEBHOOK_SECRET=
LS_CHECKOUT_30=
LS_CHECKOUT_90=
LS_VARIANT_30=
LS_VARIANT_90=
# --- E-mails de service (confirmation d'adresse, mot de passe oublié) : SMTP Google (Gmail) ---
# Compte Gmail ou Google Workspace avec validation en deux étapes + « mot de passe d'application » (16 caractères, les espaces sont ignorés).
# Gmail limite l'envoi (environ 500 messages par jour pour un compte gratuit). Sans SMTP_USER/SMTP_PASS, les e-mails sont désactivés.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                # 465 = SSL/TLS implicite ; 587 = STARTTLS
SMTP_USER=                   # votre adresse Gmail complète
SMTP_PASS=                   # mot de passe d'application
FROM_EMAIL=                  # facultatif : adresse d'expéditeur (défaut : SMTP_USER)
# Alternative : Resend (utilisé seulement si SMTP_USER/SMTP_PASS sont vides)
RESEND_API_KEY=              # facultatif

# --- Connexion avec Google (console Google Cloud > API et services > Identifiants > ID client OAuth, type « Application Web ») ---
# URI de redirection autorisée à déclarer : <NEXT_PUBLIC_SITE_URL>/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOCK_EXTERNALS=              # 1 = tous les fournisseurs simulés (et base en mémoire sans MONGODB_URI)
MOCK_MAIL=                   # 0 = envoyer réellement les e-mails même avec MOCK_EXTERNALS=1
MOCK_FAIL=                   # en mode simulé : fournisseurs qui échouent, ex. anthropic,openai (pour voir le repli)
IRCC_DRAWS_URL=https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json   # flux officiel des tirages (Canada.ca)
